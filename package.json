{
  "name": "pocket-mapp-creator",
  "productName": "Pocket-Mapp-Creator",
  "version": "0.1.0",
  "description": "Desktop fantasy, sci-fi, modern and realistic map maker - parchment, full colour and watercolour styles.",
  "main": "main.js",
  "author": "project-tech-me <project-tech-me@protonmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "assets": "node tools/generate-assets.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.projecttechme.pocketmappcreator",
    "productName": "Pocket-Mapp-Creator",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "ASSET-LICENSES.md",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "maintainer": "project-tech-me <project-tech-me@protonmail.com>",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "identity": null
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "icon": "build/icon.png",
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "${productName}-${version}-win-portable.${ext}"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "homepage": "https://github.com/Projects-me-design/Pocket-Mapp-Creator",
  "repository": {
    "type": "git",
    "url": "https://github.com/Projects-me-design/Pocket-Mapp-Creator.git"
  },
  "engines": {
    "node": ">=24"
  },
  "desktopName": "pocket-mapp-creator.desktop"
}
